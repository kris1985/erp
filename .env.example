USE_SQLITE=false
# 与 chatbi / u8s-server local 同源：root / 123456 @ localhost:3306
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/workshop?charset=utf8mb4
# 本机 Redis（docker compose 映射 6379，无密码）
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
WORKER_DEFAULT_PASSWORD=123456

# 智能排产 Agent（DeepSeek）；勿提交真实 key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SCHEDULE_AGENT_ENABLED=true
SCHEDULE_AGENT_DATA_DIR=./data/schedule_agent
