USE_SQLITE=false
# 与 chatbi / u8s-server local 同源：root / 123456 @ localhost:3306
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/workshop?charset=utf8mb4
# 本机 Redis（docker compose 映射 6379，无密码）
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
WORKER_DEFAULT_PASSWORD=123456

# 智能排产 Agent（DeepSeek）；勿提交真实 key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SCHEDULE_AGENT_ENABLED=true
SCHEDULE_AGENT_DATA_DIR=./data/schedule_agent

# —— 意图路由（问题 → 指标）——
# keyword（默认，零依赖）：关键词打分，够用即无需切换。
# 当 trace 消费端（scripts/analyze_agent_traces.py）显示「未路由/低置信」占比高时，
# 切 vector_api（推荐硅基流动，OpenAI 兼容，中文 BGE 系，成本可忽略）：
#   INTENT_EMBEDDER=vector_api
#   EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
#   EMBEDDING_API_KEY=sk-xxx
#   EMBEDDING_API_MODEL=BAAI/bge-m3
# 或 vector_local（本地 sentence-transformers + bge，需 pip install sentence-transformers，
# 适合纯内网部署；注意它比 vector_api 的 bge-large 弱）。
INTENT_EMBEDDER=keyword
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=BAAI/bge-large-zh-v1.5
