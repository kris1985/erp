# 本地 / 真机调试（npm run dev:app / dev:h5）
# 真机不要写 localhost；局域网 IP 过期时 vite 会自动换成当前网卡地址。
#VITE_API_BASE_URL=http://192.168.3.160:8000/api/v1
#VITE_H5_BASE_URL=http://192.168.3.160:8000

# 正式包（npm run build:app / build:h5）
# H5 仍走同源 /api/v1；原生 App 打包时会打进下面的绝对地址。
VITE_API_BASE_URL=https://tyulan.cn/api/v1
VITE_H5_BASE_URL=https://tyulan.cn
