# UniApp API / H5 地址（按 Vite mode 加载）
#
# 开发：复制为 .env.development，或直接改仓库里的 .env.development
# 生产：改 .env.production（默认已是 https://tyulan.cn）
# 本地覆盖（不提交）：还可建 .env.development.local / .env.production.local
#
# App/PDA 必须填设备能访问的绝对地址，不能用 localhost。
# H5 运行时强制走同源 /api/v1，下面两项主要影响原生 App 与 WebView 打开业务页。

# 开发示例
VITE_API_BASE_URL=http://192.168.1.100:8000/api/v1
VITE_H5_BASE_URL=http://192.168.1.100:8000

# 生产示例
# VITE_API_BASE_URL=https://tyulan.cn/api/v1
# VITE_H5_BASE_URL=https://tyulan.cn
