# 复制为 deploy.env 后填写: cp deploy.env.example deploy.env
# deploy.env 勿提交仓库

# 服务器（与 u8s-server SERVER1 相同）
DEPLOY_SERVER1_HOST=112.74.191.133
DEPLOY_SERVER1_PORT=22
DEPLOY_SERVER1_USER=root
# 已配置 SSH 密钥时可留空；否则填密码（需本机 sshpass）
DEPLOY_SERVER1_PASSWORD=

DEPLOY_TARGET=1

# 远程安装目录与监听端口（8000 当前空闲；勿占 80/Tomcat、8080/nginx）
REMOTE_DIR=/root/workshop-assistant
APP_PORT=8000
# 该机内存约 3.6G 且已跑 Tomcat + u8s，建议 1
APP_WORKERS=1

# 数据库：与 u8s-server 生产同源（阿里云 RDS）
# 注意：密码中的 @ 须 URL 编码为 %40
# znzroot 默认只有 znz.* 权限；无建库权时请用 znz，或先在 RDS 控制台建 workshop 并授权
DEPLOY_DB=mysql
DATABASE_URL=mysql+pymysql://znzroot:YOUR_PASSWORD@rm-wz9ade6x66ws4933v.mysql.rds.aliyuncs.com/znz?charset=utf8mb4
MYSQL_HOST=rm-wz9ade6x66ws4933v.mysql.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USER=znzroot
MYSQL_PASSWORD=YOUR_PASSWORD
MYSQL_DATABASE=znz

# 首次部署是否灌演示数据（1=是，0=否）。已有生产数据时务必为 0
SEED_DEMO=1

# 可选：写入远程 .env（留空则不覆盖已有远程配置）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# SECRET_KEY=
# 军师 Agent（不配则部署时自动从本地 .env 读取 DEEPSEEK_API_KEY）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 对外 MCP（外部 Agent；默认开启）
# MCP_ENABLED=true
# MCP_ALLOWED_ORIGINS=*
# WECHAT_TOKEN=
